<?xml version="1.0" encoding="UTF-8"?>
<!--
  window.ui — Notework 主窗口（双视图骨架）
  顶层结构：
    AdwApplicationWindow
    └── AdwToolbarView
        ├── [top]    AdwHeaderBar
        │            └── title-widget: AdwViewSwitcher（绑定 main_stack）
        └── [content] AdwViewStack id=main_stack
            ├── page "album"     —— 相册编辑视图（运行时由 album_view_new()
            │                        构造的内嵌控件填充 album_holder）
            └── page "timeline"  —— 进度轴 + 轨道列表（双区竖排）
                GtkBox vertical
                ├── GtkScrolledWindow header_scroller
                │     hscrollbar-policy=external, vscrollbar-policy=never
                │   └── GtkDrawingArea progress_axis_canvas (height-request=80)
                └── GtkScrolledWindow body_scroller
                      hscrollbar-policy=automatic, vscrollbar-policy=automatic
                    └── GtkBox track_container (orientation=vertical)

  说明：
  · header_scroller 与 body_scroller 的水平 GtkAdjustment 在 main.c 中
    单向绑定（body.value → header.value），形成“冻结表头”效果。
  · 轨道行由 main.c 用 track_row.ui 模板加载并 append 到 track_container；
    每行 bar 的 width-request 由主程序设为与进度轴等宽，使 listview 横向
    可滚动上限等于进度轴宽度。
-->
<interface>
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="AdwApplicationWindow" id="main_window">
    <property name="title">Notework</property>
    <property name="default-width">1024</property>
    <property name="default-height">700</property>

    <property name="content">
      <object class="AdwToolbarView">

        <!-- 顶部标题栏（含视图切换器） -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwViewSwitcher">
                <property name="stack">main_stack</property>
                <property name="policy">wide</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="snip_btn">
                <property name="icon-name">camera-photo-symbolic</property>
                <property name="tooltip-text">截图便签：打开 notework-snip 截图悬浮窗</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- 中央内容区：双页 ViewStack -->
        <property name="content">
          <object class="AdwViewStack" id="main_stack">

            <!-- ── 页 1：相册编辑（内嵌 album_view） ─────────────── -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">album</property>
                <property name="title">相册</property>
                <property name="icon-name">view-grid-symbolic</property>
                <property name="child">
                  <object class="GtkBox" id="album_holder">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                  </object>
                </property>
              </object>
            </child>

            <!-- ── 页 2：进度轴 + 轨道 ────────────────────────────── -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">timeline</property>
                <property name="title">进度轴</property>
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>

                    <!-- (1) 进度轴行：左侧 sidebar 占位 + 右侧进度轴（与下方轨道列右侧起点对齐） -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <child>
                          <object class="GtkBox" id="sidebar_header">
                            <property name="width-request">160</property>
                            <property name="orientation">horizontal</property>
                            <property name="hexpand">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow" id="header_scroller">
                            <property name="hscrollbar-policy">external</property>
                            <property name="vscrollbar-policy">never</property>
                            <property name="propagate-natural-height">true</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkDrawingArea" id="progress_axis_canvas">
                                <property name="height-request">60</property>
                                <property name="css-classes">progress-axis</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- (2) 轨道工具条：顶部小工具栏，提供「+ 新建轨道」入口 -->
                    <child>
                      <object class="GtkBox" id="track_toolbar">
                        <property name="orientation">horizontal</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">2</property>
                        <property name="margin-bottom">0</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="track_add_button">
                            <property name="icon-name">list-add-symbolic</property>
                            <property name="tooltip-text">新建轨道</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- (3) 内容行：左侧 sidebar (名称+删除) + 右侧轨道 bar（水平滚动） -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkScrolledWindow" id="sidebar_scroller">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vscrollbar-policy">external</property>
                            <property name="width-request">160</property>
                            <property name="hexpand">false</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkBox" id="sidebar_container">
                                <property name="orientation">vertical</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">4</property>
                                <property name="spacing">2</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow" id="body_scroller">
                            <property name="hscrollbar-policy">always</property>
                            <property name="vscrollbar-policy">automatic</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkBox" id="track_container">
                                <property name="orientation">vertical</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">4</property>
                                <property name="spacing">2</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- (4) 第三区：选中激活区域后展示其绑定的高亮记录列表 -->
                    <child>
                      <object class="GtkBox" id="bindings_panel">
                        <property name="orientation">horizontal</property>
                        <property name="height-request">60</property>
                        <property name="hexpand">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="width-request">160</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="bindings_title">
                                <property name="label">未选中激活区域</property>
                                <property name="halign">start</property>
                                <property name="wrap">true</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">4</property>
                                <child>
                                  <object class="GtkButton" id="bindings_add_btn">
                                    <property name="label">+ 添加</property>
                                    <property name="sensitive">false</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="bindings_clear_btn">
                                    <property name="label">清空</property>
                                    <property name="sensitive">false</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="bindings_remove_pair_btn">
                                    <property name="label">删除激活区域</property>
                                    <property name="tooltip-text">从轨道中删除当前选中的激活区域</property>
                                    <property name="sensitive">false</property>
                                    <style>
                                      <class name="destructive-action"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vscrollbar-policy">automatic</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkListBox" id="bindings_list">
                                <property name="selection-mode">single</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </child>

            <!-- ── 页 3：LaTeX 输入 / 预览 ─────────────────── -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">latex</property>
                <property name="title">LaTeX</property>
                <property name="icon-name">accessories-text-editor-symbolic</property>
                <property name="child">
                  <object class="GtkBox" id="latex_holder">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </object>
</interface>
