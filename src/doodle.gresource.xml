<?xml version="1.0" encoding="UTF-8"?>
<!--
  doodle.gresource.xml — 涂鸦模块独立资源清单
  使用单独 prefix 避免与主程序资源冲突；同时复用主程序的 style.css。
-->
<gresources>
  <gresource prefix="/com/github/notework/doodle">
    <file preprocess="xml-stripblanks">doodle_window.ui</file>
  </gresource>
  <gresource prefix="/com/github/notework">
    <file>style.css</file>
  </gresource>
</gresources>
